s {\n        panic!(\"Matrix dimensions do not match for multiplication\");\n    }\n    let mut result = Matrix::new(a.rows, b.cols);\n    for i in 0..a.rows {\n        for j in 0..b.cols {\n            let mut sum = 0.0f32;\n            for k in 0..a.cols {\n                sum += a.get(i, k) * b.get(k, j);\n            }\n            result.get_mut(i, j).copy_from_slice(&sum.to_le_bytes());\n        }\n    }\n    result\n}\n\n/// Prints a float array with the specified format.\npub fn print_float_array(matrix: &Matrix) -> i32 {\n    for i in 0..matrix.rows {\n        for j in 0..matrix.cols {\n            print!(\"{:10.2} \", matrix.get(i, j));\n        }\n        println!();\n    }\n    0\n}\n\n/// Prints an array with a header and type check.\npub fn print_array(matrix: &Matrix, name: &str, type_str: &str) -> i32 {\n    println!(\"------------{}--------------\", name);\n    if type_str == \"float\" {\n        print_float_array(matrix);\n    } else {\n        print!(\"unsupported {}\", type_str);\n    }\n    0\n}"), best_reward: 0.0 }
