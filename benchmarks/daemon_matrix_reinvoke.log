    for j in 0..y2 {\n            r[i][j] = 0.0;\n            for k in 0..y1 {\n                r[i][j] += m1[i][k] * m2[k][j];\n            }\n        }\n    }\n    0\n}\n\npub fn algorithm2(a: &Vec<Vec<f32>>, bb: &Vec<Vec<f32>>, c: &mut Vec<Vec<f32>>, size: usize) -> i32 {\n    let mut b = vec![vec![0.0f32; size]; size];\n    for i in 0..size {\n        for j in 0..size {\n            b[i][j] = bb[j][i];\n            c[i][j] = 0.0;\n        }\n    }\n\n    for i in 0..size {\n        for j in 0..size {\n            for k in 0..size {\n                c[i][k] += a[i][j] * b[k][j];\n            }\n        }\n    }\n    0\n}\n\npub fn algorithm3(m1: &Vec<Vec<f32>>, m2: &Vec<Vec<f32>>, r: &mut Vec<Vec<f32>>, x1: usize, y1: usize, x2: usize, y2: usize) -> i32 {\n    for i in 0..x1 {\n        for j in 0..y2 {\n            r[i][j] = 0.0;\n        }\n    }\n\n    for i in 0..x1 {\n        for k in 0..y1 {\n            for j in 0..y2 {\n                r[i][j] += m1[i][k] * m2[k][j];\n            }\n        }\n    }\n    0\n}"), best_reward: 0.4 }
