atrix::free_matrix(&mut matrix_data);\n}\n\npub fn test_multiply(x1: usize, y1: usize, x2: usize, y2: usize, test_name: &str, method: i32) -> i32 {\n    let mut matrix1 = matrix::generate_matrix(x1, y1, false);\n    let mut matrix2 = matrix::generate_matrix(x2, y2, false);\n    let mut r = matrix::generate_matrix(x1, y2, true);\n\n    let flag = matrix::multiply(&matrix1, &matrix2, &mut r, method);\n\n    if flag != 0 {\n        println!(\"error: x1={} y1={} x2={} y2={} method={}\", x1, y1, x2, y2, method);\n    } else {\n        println!(\"={}\", test_name);\n        utils::print_array(&matrix1, \"matrix1\", utils::ARRAY_TYPE_CHAR);\n        utils::print_array(&matrix2, \"matrix2\", utils::ARRAY_TYPE_CHAR);\n        utils::print_array(&r, \"result\", utils::ARRAY_TYPE_CHAR);\n        println!(\"================\");\n    }\n\n    matrix::free_matrix(&mut matrix1);\n    matrix::free_matrix(&mut matrix2);\n    matrix::free_matrix(&mut r);\n\n    flag\n}\n\npub fn tests_generate_matrix() {\n    test_generate_matrix(4, 4, Some(\"4x4\"), utils::ARRAY_TYPE_CHAR);\n    test_generate_matrix(3, 4, Some(\"3x4\"), utils::ARRAY_TYPE_CHAR);\n    test_generate_matrix(4, 3, Some(\"4x3\"), utils::ARRAY_TYPE_CHAR);\n    test_generate_matrix(0, 0, Some(\"0x0\"), utils::ARRAY_TYPE_CHAR);\n    test_generate_matrix(2, 2, None, utils::ARRAY_TYPE_CHAR);\n}\n\npub fn tests_multiply() {\n    assert_eq!(test_multiply(2, 2, 2, 2, \"method 1\", 1), 0);\n    assert_eq!(test_multiply(2, 2, 2, 2, \"method 2\", 2), 0);\n    assert_eq!(test_multiply(2, 2, 2, 2, \"method 3\", 3), 0);\n    assert_ne!(test_multiply(2, 2, 2, 2, \"method 0\", 0), 0);\n}"), best_reward: 0.0 }
