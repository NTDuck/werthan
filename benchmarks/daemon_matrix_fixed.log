: usize,\n        y2: usize,\n    ) -> i32 {\n        for i in 0..x1 {\n            for j in 0..y2 {\n                r[i][j] = 0.0;\n                for k in 0..y1 {\n                    r[i][j] += m1[i][k] * m2[k][j];\n                }\n            }\n        }\n        0\n    }\n\n    pub fn algorithm2(a: &Matrix, bb: &Matrix, c: &mut Matrix, size: usize) -> i32 {\n        let mut b: Matrix = Vec::with_capacity(size);\n        for i in 0..size {\n            let mut row: Vec<f32> = Vec::with_capacity(size);\n            for j in 0..size {\n                row.push(bb[j][i]);\n            }\n            b.push(row);\n        }\n\n        for i in 0..size {\n            for j in 0..size {\n                c[i][j] = 0.0;\n            }\n        }\n\n        for i in 0..size {\n            for j in (0..size).step_by(8) {\n                let end = std::cmp::min(j + 8, size);\n                for k in 0..size {\n                    let mut sum = 0.0f32;\n                    for jj in j..end {\n                        sum += a[i][jj] * b[k][jj];\n                    }\n                    c[i][k] += sum;\n                }\n            }\n        }\n        0\n    }\n\n    pub fn algorithm3(\n        m1: &Matrix,\n        m2: &Matrix,\n        r: &mut Matrix,\n        x1: usize,\n        y1: usize,\n        _x2: usize,\n        y2: usize,\n    ) -> i32 {\n        for i in 0..x1 {\n            for j in 0..y2 {\n                r[i][j] = 0.0;\n            }\n        }\n        for i in 0..x1 {\n            for k in 0..y1 {\n                for j in 0..y2 {\n                    r[i][j] += m1[i][k] * m2[k][j];\n                }\n            }\n        }\n        0\n    }\n\n    fn rand_f32() -> f32 {\n        let mut state = std::time::SystemTime::now()\n            .duration_since(std::time::UNIX_EPOCH)\n            .unwrap()\n            .as_nanos() as u64;\n        state ^= state >> 33;\n        state = (state ^ (state << 7)) & 0x3F5AEB;\n        state ^= state >> 17;