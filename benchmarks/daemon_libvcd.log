pub fn read_from_path(path: &str) -> io::Result<VCD> {\n        let file = std::fs::File::open(path)?;\n        let reader = BufReader::new(file);\n        let mut vcd = VCD::new();\n        let mut current_timestamp: Timestamp = 0;\n        let mut state = State::BeforeModuleDefinitions;\n\n        let mut buf = [0u8; BUFFER_LENGTH];\n        let mut pos = 0usize;\n        let mut eof = false;\n\n        macro_rules! next_char {\n            () => {{\n                if pos >= buf.len() || eof {\n                    let n = reader.read(&mut buf)?;\n                    if n == 0 {\n                        eof = true;\n                        return Ok(vcd);\n                    }\n                    pos = 0;\n                }\n                let c = buf[pos];\n                pos += 1;\n                c\n            }};\n        }\n\n        macro_rules! unget_char {\n            () => {{\n                if pos > 0 {\n                    pos -= 1;\n                }\n            }};\n        }\n\n        while !eof {\n            let c = next_char!();\n\n            if c == b'$' {\n                if !Self::parse_instruction(reader, &mut vcd, &mut state, &mut buf, &mut pos, &mut eof)? {\n                    return Err(io::Error::new(io::ErrorKind::Other, \"parse instruction failed\"));\n                }\n            } else if c == b'#' {\n                if !Self::parse_timestamp(reader, &mut current_timestamp, &mut buf, &mut pos, &mut eof)? {\n                    return Err(io::Error::new(io::ErrorKind::Other, \"parse timestamp failed\"));\n                }\n            } else if isexpression(c) {\n                unget_char!();\n                if !Self::parse_assignment(reader, &mut vcd, current_timestamp, &mut buf, &mut pos, &mut eof)? {\n                    return Err(io::Error::new(io::ErrorKind::Other, \"parse assignment failed\"));\n                }\n            } else if c.is_ascii_whitespace() {\n                continue;\n            } else {\n                return Err(io::Error::new(io::ErrorKind::Other, \"unexpected character\"));\n            }\n        }\n\n        Ok(vcd)\n    }\n\n    pub fn get_signal_by_name(&self, signal_name: &str) -> Option<&Signal> {\n        self.signals.iter().find(|s| s.name == signal_name)\n    }\n\n    fn parse_instruction(\n        reader: &mut BufReader<std::fs::File>,\n        vcd: &mut VCD,\n        state: &mut State,\n        buf: &mut [u8; BUFFER_LENGTH],\n        pos: &mut usize,\n        eof: &mut bool,\n    ) -> io::Result<bool> {\n        let instruction = Self::read_token(reader, buf, pos, eof)?;\n        let instruction_str = String::from_utf8_lossy(&instruction).to_string();\n\n        match instruction_str.as_str() {\n            \"end\" | \"dumpvars\" | \"dumpall\" => return Ok(true),\n            \"scope\" => {\n                match *state {\n                    State::BeforeModuleDefinitions => *state = State::InsideTopModule,\n                    State::InsideTopModule => *state = State::InsideInnerModules,\n                    _ => {}\n                }\n                Self::skip_to_dollar(reader, buf, pos, eof)?;\n                return Ok(true);\n            }\n            \"upscope\" | \"enddefinitions\" | \"comment\" => {\n                Self::skip_to_dollar(reader, buf, pos, eof)?;\n                return Ok(true);\n            }\n            \"var\" => {\n                if *state == State::InsideInnerModules {\n                    Self::skip_to_newline(reader, buf, pos, eof)?;\n                    return Ok(true);\n                }\n\n                let size_str = Self::read_token(reader, buf, pos, eof)?;\n                let size: usize = std::str::from_utf8(&size_str)\n                    .ok()\n                    .and_then(|s| s.parse().ok())\n                    .unwrap_or(0);\n\n                let signal_id = Self::read_token(reader, buf, pos, eof)?;\n                let signal_name = Self::read_token(reader, buf, pos, eof)?;\n\n                let name_str = String::from_utf8_lossy(&signal_name).to_string();\n                let id_str = String::from_utf8_lossy(&signal_id).to_string();\n\n                let index = get_signal_index(&id_str).unwrap_or(0);\n\n                if vcd.signals.len() <= index {\n                    vcd.signals.resize(index + 1, Signal {\n                        name: String::new(),\n                        size: 0,\n                        value_changes: Vec::new(),\n                    });\n                }\n\n                if vcd.signals[index].size != 0 {\n                    return Ok(true);\n                }\n\n                vcd.signals[index] = Signal {\n                    name: name_str,\n                    size,\n                    value_changes: Vec::new(),\n                };\n\n                return Ok(true);\n            }\n            \"date\" => {\n                let date_str = Self::read_until_dollar(reader, buf, pos, eof)?;\n                vcd.date = String::from_utf8_lossy(&date_str).trim().to_string();\n                return Ok(true);\n            }\n            \"version\" => {\n                let version_str = Self::read_until_dollar(reader, buf, pos, eof)?;\n                vcd.version = String::from_utf8_lossy(&version_str).trim().to_string();\n                return Ok(true);\n            }\n            \"timescale\" => {\n                let ts_str = Self::read_until_dollar(reader, buf, pos, eof)?;\n                let ts_trimmed = String::from_utf8_lossy(&ts_str).trim().to_string();\n                let mut parts = ts_trimmed.splitn(2, char::is_whitespace);\n                let scale_part = parts.next().unwrap_or(\"0\");\n                let unit_part = parts.next().unwrap_or(\"\");\n                vcd.timescale.scale = scale_part.parse().unwrap_or(0);\n                vcd.timescale.unit = unit_part.to_string();\n                return Ok(true);\n            }\n            _ => return Ok(false),\n        }\n    }\n\n    fn parse_timestamp(\n        reader: &mut BufReader<std::fs::File>,\n        timestamp: &mut Timestamp,\n        buf: &mut [u8; BUFFER_LENGTH],\n        pos: &mut usize,\n        eof: &mut bool,\n    ) -> io::Result<bool> {\n        let num_str = Self::read_number(reader, buf, pos, eof)?;\n        *timestamp = num_str;\n        Ok(true)\n    }\n\n    fn parse_assignment(\n        reader: &mut BufReader<std::fs::File>,\n        vcd: &mut VCD,\n        timestamp: Timestamp,\n        buf: &mut [u8; BUFFER_LENGTH],\n        pos: &mut usize,\n        eof: &mut bool,\n    ) -> io::Result<bool> {\n        let line = Self::read_line(reader, buf, pos, eof)?;\n        let line_str = String::from_utf8_lossy(&line).to_string();\n\n        let is_vector = !line_str\n            .chars()\n            .next()\n            .map(|c| matches!(c, '0' | '1' | 'x' | 'X' | 'z' | 'Z'))\n            .unwrap_or(false);\n\n        let (value, signal_id) = if is_vector {\n            let parts: Vec<&str> = line_str.split_whitespace().collect();\n            if parts.len() < 2 {\n                return Ok(true);\n            }\n            (parts[0].to_string(), parts[1].to_string())\n        } else {\n            if line_str.len() < 2 {\n                return Ok(true);\n            }\n            (\n                line_str.chars().next().unwrap().to_string(),\n                line_str[1..].trim().to_string(),\n            )\n        };\n\n        if signal_id.len() > 1 {\n            return Ok(true);\n        }\n\n        let index = match get_signal_index(&signal_id) {\n            Some(i) => i,\n            None => return Ok(true),\n        };\n\n        if index >= vcd.signals.len() {\n            return Ok(true);\n        }\n\n        vcd.signals[index].value_changes.push(ValueChange {\n            timestamp,\n            value,\n        });\n\n        Ok(true)\n    }\n\n    fn read_token(\n        reader: &mut BufReader<std::fs::File>,\n        buf: &mut [u8; BUFFER_LENGTH],\n        pos: &mut usize,\n        eof: &mut bool,\n    ) -> io::Result<Vec<u8>> {\n        let mut token = Vec::new();\n        loop {\n            if *pos >= buf.len() || *eof {\n                let n = reader.read(&mut *buf)?;\n                if n == 0 {\n                    *eof = true;\n                    break;\n                }\n                *pos = 0;\n            }\n            let c = buf[*pos];\n            *pos += 1;\n            if c.is_ascii_whitespace() {\n                if !token.is_empty() {\n                    break;\n                }\n                continue;\n            }\n            token.push(c);\n        }\n        Ok(token)\n    }\n\n    fn read_number(\n        reader: &mut BufReader<std::fs::File>,\n        buf: &mut [u8; BUFFER_LENGTH],\n        pos: &mut usize,\n        eof: &mut bool,\n    ) -> io::Result<Timestamp> {\n        let mut num: u32 = 0;\n        let mut found_digit = false;\n        loop {\n            if *pos >= buf.len() || *eof {\n                let n = reader.read(&mut *buf)?;\n                if n == 0 {\n                    *eof = true;\n                    break;\n                }\n                *pos = 0;\n            }\n            let c = buf[*pos];\n            *pos += 1;\n            if c.is_ascii_digit() {\n                num = num * 10 + (c - b'0') as u32;\n                found_digit = true;\n            } else {\n                if found_digit {\n                    break;\n                }\n                continue;\n            }\n        }\n        Ok(num)\n    }\n\n    fn read_line(\n        reader: &mut BufReader<std::fs::File>,\n        buf: &mut [u8; BUFFER_LENGTH],\n        pos: &mut usize,\n        eof: &mut bool,\n    ) -> io::Result<Vec<u8>> {\n        let mut line = Vec::new();\n        loop {\n            if *pos >= buf.len() || *eof {\n                let n = reader.read(&mut *buf)?;\n                if n == 0 {\n                    *eof = true;\n                    break;\n                }\n                *pos = 0;\n            }\n            let c = buf[*pos];\n            *pos += 1;\n            if c == b'\\n' {\n                break;\n            }\n            line.push(c);\n        }\n        Ok(line)\n    }\n\n    fn skip_to_dollar(\n        reader: &mut BufReader<std::fs::File>,\n        buf: &mut [u8; BUFFER_LENGTH],\n        pos: &mut usize,\n        eof: &mut bool,\n    ) -> io::Result<()> {\n        loop {\n            if *pos >= buf.len() || *eof {\n                let n = reader.read(&mut *buf)?;\n                if n == 0 {\n                    *eof = true;\n                    return Ok(());\n                }\n                *pos = 0;\n            }\n            let c = buf[*pos];\n            *pos += 1;\n            if c == b'$' {\n                break;\n            }\n        }\n        Ok(())\n    }\n\n    fn skip_to_newline(\n        reader: &mut BufReader<std::fs::File>,\n        buf: &mut [u8; BUFFER_LENGTH],\n        pos: &mut usize,\n        eof: &mut bool,\n    ) -> io::Result<()> {\n        loop {\n            if *pos >= buf.len() || *eof {\n                let n = reader.read(&mut *buf)?;\n                if n == 0 {\n                    *eof = true;\n                    return Ok(());\n                }\n                *pos = 0;\n            }\n            let c = buf[*pos];\n            *pos += 1;\n            if c == b'\\n' {\n                break;\n            }\n        }\n        Ok(())\n    }\n\n    fn read_until_dollar(\n        reader: &mut BufReader<std::fs::File>,\n        buf: &mut [u8; BUFFER_LENGTH],\n        pos: &mut usize,\n        eof: &mut bool,\n    ) -> io::Result<Vec<u8>> {\n        let mut result = Vec::new();\n        loop {\n            if *pos >= buf.len() || *eof {\n                let n = reader.read(&mut *buf)?;\n                if n == 0 {\n                    *eof = true;\n                    break;\n                }\n                *pos = 0;\n            }\n            let c = buf[*pos];\n   