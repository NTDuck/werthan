usize,\n        eof: &mut bool,\n    ) -> io::Result<Vec<u8>> {\n        let mut token = Vec::new();\n        loop {\n            if *pos >= buf.len() || *eof {\n                let n = reader.read(&mut *buf)?;\n                if n == 0 {\n                    *eof = true;\n                    break;\n                }\n                *pos = 0;\n            }\n            let c = buf[*pos];\n            *pos += 1;\n            if c.is_ascii_whitespace() {\n                if !token.is_empty() {\n                    break;\n                }\n                continue;\n            }\n            token.push(c);\n        }\n        Ok(token)\n    }\n\n    fn read_number(\n        reader: &mut BufReader<std::fs::File>,\n        buf: &mut [u8; BUFFER_LENGTH],\n        pos: &mut usize,\n        eof: &mut bool,\n    ) -> io::Result<Timestamp> {\n        let mut num: u32 = 0;\n        let mut found_digit = false;\n        loop {\n            if *pos >= buf.len() || *eof {\n                let n = reader.read(&mut *buf)?;\n                if n == 0 {\n                    *eof = true;\n                    break;\n                }\n                *pos = 0;\n            }\n            let c = buf[*pos];\n            *pos += 1;\n            if c.is_ascii_digit() {\n                num = num * 10 + (c - b'0') as u32;\n                found_digit = true;\n            } else {\n                if found_digit {\n                    break;\n                }\n                continue;\n            }\n        }\n        Ok(num)\n    }\n\n    fn read_line(\n        reader: &mut BufReader<std::fs::File>,\n        buf: &mut [u8; BUFFER_LENGTH],\n        pos: &mut usize,\n        eof: &mut bool,\n    ) -> io::Result<Vec<u8>> {\n        let mut line = Vec::new();\n        loop {\n            if *pos >= buf.len() || *eof {\n                let n = reader.read(&mut *buf)?;\n                if n == 0 {\n                    *eof = true;\n                    break;\n                }\n      