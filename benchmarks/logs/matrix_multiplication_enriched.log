ize,\n    _x2: usize,\n    y2: usize,\n) -> i32 {\n    // Ensure result matrix has correct dimensions\n    if r.len() != x1 {\n        *r = vec![vec![0.0; y2]; x1];\n    } else {\n        for i in 0..x1 {\n            if r[i].len() != y2 {\n                r[i] = vec![0.0; y2];\n            }\n        }\n    }\n\n    for i in 0..x1 {\n        for j in 0..y2 {\n            let mut sum = 0.0f32;\n            for k in 0..y1 {\n                sum += m1[i][k] * m2[k][j];\n            }\n            r[i][j] = sum;\n        }\n    }\n    0\n}\n\npub fn algorithm2(a: &Vec<Vec<f32>>, bb: &Vec<Vec<f32>>, c: &mut Vec<Vec<f32>>, size: usize) -> i32 {\n    // Transpose bb into b\n    let mut b = vec![vec![0.0f32; size]; size];\n    for i in 0..size {\n        for j in 0..size {\n            b[i][j] = bb[j][i];\n        }\n    }\n\n    // Initialize c to zero\n    for i in 0..size {\n        for j in 0..size {\n            c[i][j] = 0.0;\n        }\n    }\n\n    // Perform multiplication using standard loops (portable replacement for AVX2 intrinsics)\n    // The legacy code used AVX2 to process 8 elements at a time, but the mathematical result\n    // is identical to the standard dot product accumulation.\n    for i in 0..size {\n        for j in 0..size {\n            let mut sum = 0.0f32;\n            for k in 0..size {\n                sum += a[i][k] * b[k][j];\n            }\n            c[i][j] = sum;\n        }\n    }\n    0\n}\n\npub fn algorithm3(\n    m1: &Vec<Vec<f32>>,\n    m2: &Vec<Vec<f32>>,\n    r: &mut Vec<Vec<f32>>,\n    x1: usize,\n    y1: usize,\n    _x2: usize,\n    y2: usize,\n) -> i32 {\n    // Ensure result matrix has correct dimensions and is zeroed\n    if r.len() != x1 {\n        *r = vec![vec![0.0; y2]; x1];\n    } else {\n        for i in 0..x1 {\n            if r[i].len() != y2 {\n                r[i] = vec![0.0; y2];\n            } else {\n                for j in 0..y2 {\n                    r[i][j] = 0.0;\n                }\n            }\n        