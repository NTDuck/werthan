t parts: Vec<&str> = line.split_whitespace().collect();\n            if parts.is_empty() {\n                continue;\n            }\n            let state_idx: usize = parts[0].parse().unwrap();\n            // Ensure state exists\n            while self.n_states <= state_idx {\n                self.add_state();\n            }\n            let mut i = 1;\n            while i < parts.len() {\n                if i + 4 < parts.len() {\n                    // Arc: ilabel olabel weight next_state\n                    let ilabel: u32 = parts[i].parse().unwrap();\n                    let olabel: u32 = parts[i + 1].parse().unwrap();\n                    let weight: f64 = parts[i + 2].parse().unwrap();\n                    let next_state: usize = parts[i + 3].parse().unwrap();\n                    // Ensure next state exists\n                    while self.n_states <= next_state {\n                        self.add_state();\n                    }\n                    self.add_arc(\n                        State(state_idx),\n                        State(next_state),\n                        ilabel,\n                        olabel,\n                        weight,\n                    );\n                    i += 4;\n                } else if i + 1 < parts.len() {\n                    // Final state: weight\n                    let weight: f64 = parts[i].parse().unwrap();\n                    self.set_final(State(state_idx), weight);\n                    i += 1;\n                } else {\n                    break;\n                }\n            }\n        }\n    }\n\n    pub fn compose(&mut self, fst_0: &Fst, fst_1: &Fst) {\n        self.states.clear();\n        self.n_states = 0;\n\n        // Create start state\n        let start = self.add_state();\n\n        // BFS/DFS to build composition\n        let mut visited: HashMap<(State, State), State> = HashMap::new();\n        visited.insert((State(0), State(0)), start);\n\n        let mut queue: Vec<(State, State)> = vec![(State(0), State(0))];\n\n        while let Some((s0, s1)) = queue.pop() {\n            let comp_state = visited[&(s0, s1)];\n\n            // Check if both are final\n            if fst_0.states[s0.0].final_state && fst_1.states[s1.0].final_state {\n                let w = fst_0.states[s0.0].weight + fst_1.states[s1.0].weight;\n                self.set_final(comp_state, w);\n            }\n\n            // For each arc in fst_0 from s0\n            for arc0 in &fst_0.states[s0.0].arcs {\n                // For each arc in fst_1 from s1 with matching ilabel\n                for arc1 in &fst_1.states[s1.0].arcs {\n                    if arc0.ilabel == arc1.ilabel {\n                        let next0 = arc0.next_state;\n                        let next1 = arc1.next_state;\n                        let key = (next0, next1);\n                        if !visited.contains_key(&key) {\n                            let new_state = self.add_state();\n                            visited.insert(key, new_state);\n                            queue.push(key);\n                        }\n                        let target = visited[&key];\n                        let weight = arc0.weight + arc1.weight;\n                        self.add_arc(\n                            comp_state,\n                            target,\n                            arc0.ilabel,\n                            arc1.olabel,\n                            weight,\n                        );\n                    }\n                }\n            }\n        }\n    }\n\n    pub fn shortest(&self, path: &mut Fst) {\n        path.states.clear();\n        path.n_states = 0;\n\n        if self.n_states == 0 {\n            return;\n        }\n\n        // Dijkstra's algorithm\n        let n = self.n_states;\n        let mut dist: Vec<f64> = vec![f64::INFINITY; n];\n        let mut prev: Vec<Option<usize>> = vec![None; n];\n        let mut prev_arc: Vec<Option<usize>> = vec![None; n];\n        dist[0] = 0.0;\n\n        let mut visited: Vec<bool> = vec![false; n];\n\n        for _ in 0..n {\n            // Find unvisited node with minimum distance\n            let mut min_dist = f64::INFINITY;\n            let mut min_node = None;\n            for i in 0..n {\n                if !visited[i] && dist[i] < min_dist {\n                    min_dist = dist[i];\n                    min_node = Some(i);\n                }\n            }\n            let Some(u) = min_node else {\n                break;\n            };\n            visited[u] = true;\n\n            // Relax edges\n            for (arc_idx, arc) in self.states[u].arcs.iter().enumerate() {\n                let v = arc.next_state.0;\n                let new_dist = dist[u] + arc.weight;\n                if new_dist < dist[v] {\n                    dist[v] = new_dist;\n                    prev[v] = Some(u);\n                    prev_arc[v] = Some(arc_idx);\n                }\n            }\n        }\n\n        // Find final state with minimum distance\n        let mut best_final = None;\n        let mut best_dist = f64::INFINITY;\n        for i in 0..n {\n            if self.states[i].final_state && dist[i] < best_dist {\n                best_dist = dist[i];\n                best_final = Some(i);\n            }\n        }\n\n        let Some(final_state) = best_final else {\n            return;\n        };\n\n        // Reconstruct path\n        let mut path_states: Vec<usize> = Vec::new();\n        let mut path_arcs: Vec<(usize, usize)> = Vec::new(); // (from_state, arc_index)\n        let mut current = final_state;\n        loop {\n            path_states.push(current);\n            if let Some(p) = prev[current] {\n                let arc_idx = prev_arc[current].unwrap();\n                path_arcs.push((p, arc_idx));\n                current = p;\n            } else {\n                break;\n            }\n        }\n        path_states.reverse();\n        path_arcs.reverse();\n\n        // Build path FST\n        let mut f