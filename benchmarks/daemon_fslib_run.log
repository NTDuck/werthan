2026-11-02T04:47:05.840069Z  INFO global_engine: dispatch_module: vertex bin/compactify.c finished with outcome BudgetExhausted { module_id: "bin/compactify.c", proof_trace: "Rollout budget exhausted on parentless module bin/compactify.c with no contract counterparty", best_candidate: Some("use std::cmp::Ordering;\nuse std::collections::HashMap;\n\n// ==================== FST (Finite State Transducer) ====================\n\n#[derive(Debug, Clone, PartialEq)]\npub struct ArcData {\n    pub ilabel: u32,\n    pub olabel: u32,\n    pub weight: f64,\n    pub next_state: State,\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\npub struct State(pub usize);\n\n#[derive(Debug, Clone)]\npub struct StateData {\n    pub arcs: Vec<ArcData>,\n    pub final_state: bool,\n    pub weight: f64,\n}\n\n#[derive(Debug, Clone)]\npub struct Fst {\n    pub states: Vec<StateData>,\n    pub n_states: usize,\n}\n\nimpl Fst {\n    pub fn new() -> Self {\n        Fst {\n            states: Vec::new(),\n            n_states: 0,\n        }\n    }\n\n    pub fn add_state(&mut self) -> State {\n        let idx = self.n_states;\n        self.states.push(StateData {\n            arcs: Vec::new(),\n            final_state: false,\n            weight: 0.0,\n        });\n        self.n_states += 1;\n        State(idx)\n    }\n\n    pub fn add_arc(\n        &mut self,\n        state_a: State,\n        state_b: State,\n        ilabel: u32,\n        olabel: u32,\n        weight: f64,\n    ) {\n        let arc = ArcData {\n            ilabel,\n            olabel,\n            weight,\n            next_state: state_b,\n        };\n        self.states[state_a.0].arcs.push(arc);\n    }\n\n    pub fn set_final(&mut self, state: State, weight: f64) {\n        self.states[state.0].final_state = true;\n        self.states[state.0].weight = weight;\n    }\n\n    pub fn compile_str(&mut self, input: &str) {\n        let lines: Vec<&str> = input.lines().collect();\n        for line in lines {\n            let parts: Vec<&str> = line.split_whitespace().collect();\n            if parts.is_empty() {\n                continue;\n            }\n            let state_idx: usize = parts[0].parse().unwrap();\n            // Ensure state exists\n            while self.n_states <= state_idx {\n                self.add_state();\n            }\n            let mut i = 1;\n            while i < parts.len() {\n                if i + 4 < parts.len() {\n                    // Arc: ilabel olabel weight next_state\n                    let ilabel: u32 = parts[i].parse().unwrap();\n                    let olabel: u32 = parts[i + 1].parse().unwrap();\n                    let weight: f64 = parts[i + 2].parse().unwrap();\n                    let next_state: usize = parts[i + 3].parse().unwrap();\n                    // Ensure next state exists\n                    while self.n_states <= next_state {\n                        self.add_state();\n                    }\n                    self.add_arc(\n                        State(state_idx),\n                        State(next_state),\n                        ilabel,\n                        olabel,\n                        weight,\n                    );\n                    i += 4;\n                } else if i + 1 < parts.len() {\n                    // Final state: weight\n                    let weight: f64 = parts[i].parse().unwrap();\n                    self.set_final(State(state_idx), weight);\n                    i += 1;\n                } else {\n                    break;\n                }\n            }\n        }\n    }\n\n    pub fn compose(&mut self, fst_0: &Fst, fst_1: &Fst) {\n        self.states.clear();\n        self.n_states = 0;\n\n        // Create start state\n        let start = self.add_state();\n\n        // BFS/DFS to build composition\n        let mut visited: HashMap<(State, State), State> = HashMap::new();\n        visited.insert((State(0), State(0)), start);\n\n        let mut queue: Vec<(State, State)> = vec![(State(0), State(0))];\n\n        while let Some((s0, s1)) = queue.pop() {\n            let comp_state = visited[&(s0, s1)];\n\n            // Check if both are final\n            if fst_0.states[s0.0].final_state && fst_1.states[s1.0].final_state {\n                let w = fst_0.states[s0.0].weight + fst_1.states[s1.0].weight;\n                self.set_final(comp_state, w);\n            }\n\n            // For each arc in fst_0 from s0\n            for arc0 in &fst_0.states[s0.0].arcs {\n                // For each arc in fst_1 from s1 with matching ilabel\n                for arc1 in &fst_1.states[s1.0].arcs {\n                    if arc0.ilabel == arc1.ilabel {\n                        let next0 = arc0.next_state;\n                        let next1 = arc1.next_state;\n                        let key = (next0, next1);\n                        if !visited.contains_key(&key) {\n                            let new_state = self.add_state();\n                            visited.insert(key, new_state);\n                            queue.push(key);\n                        }\n                        let target = visited[&key];\n                        let weight = arc0.weight + arc1.weight;\n                        self.add_arc(\n                            comp_state,\n                            target,\n                            arc0.ilabel,\n                            arc1.olabel,\n                            weight,\n                        );\n                    }\n                }\n            }\n        }\n    }\n\n    pub fn shortest(&self, path: &mut Fst) {\n        path.states.clear();\n        path.n_states = 0;\n\n        if self.n_states == 0 {\n            return;\n        }\n\n        // Dijkstra's algorithm\n        let n = self.n_states;\n        let mut dist: Vec<f64> = vec![f64::INFINITY; n];\n        let mut prev: Vec<Option<usize>> = vec![None; n];\n        let mut prev_arc: Vec<Option<usize>> = vec![None; n];\n        dist[0] = 0.0;\n\n        let mut visited: Vec<bool> = vec![false; n];\n\n        for _ in 0..n {\n            // Find unvisited node with minimum distance\n            let mut min_dist = f64::INFINITY;\n            let mut min_node = None;\n            for i in 0..n {\n                if !visited[i] && dist[i] < min_dist {\n                    min_dist = dist[i];\n                    min_node = Some(i);\n                }\n            }\n            let Some(u) = min_node else {\n                break;\n            };\n            visited[u] = true;\n\n            // Relax edges\n            for (arc_idx, arc) in self.states[u].arcs.iter().enumerate() {\n                let v = arc.next_state.0;\n                let new_dist = dist[u] + arc.weight;\n                if new_dist < dist[v] {\n                    dist[v] = new_dist;\n                    prev[v] = Some(u);\n                    prev_arc[v] = Some(arc_idx);\n                }\n            }\n        }\n\n        // Find final state with minimum distance\n        let mut best_final = None;\n        let mut best_dist = f64::INFINITY;\n        for i in 0..n {\n            if self.states[i].final_state && dist[i] < best_dist {\n                best_dist = dist[i];\n                best_final = Some(i);\n            }\n        }\n\n        let Some(final_state) = best_final else {\n            return;\n        };\n\n        // Reconstruct path\n        let mut path_states: Vec<usize> = Vec::new();\n        let mut path_arcs: Vec<(usize, usize)> = Vec::new(); // (from_state, arc_index)\n        let mut current = final_state;\n        loop {\n            path_states.push(current);\n            if let Some(p) = prev[current] {\n                let arc_idx = prev_arc[current].unwrap();\n                path_arcs.push((p, arc_idx));\n                current = p;\n            } else {\n                break;\n            }\n        }\n        path_states.reverse();\n        path_arcs.reverse();\n\n        // Build path FST\n        let mut fst_states: Vec<State> = Vec::new();\n        for _ in &path_states {\n            fst_states.push(path.add_state());\n        }\n\n        for i in 0..path_states.len() - 1 {\n            let from = path_states[i];\n            let arc_idx = path_arcs[i].1;\n            let arc = &self.states[from].arcs[arc_idx];\n            path.add_arc(\n                fst_states[i],\n                fst_states[i + 1],\n                arc.ilabel,\n                arc.olabel,\n                arc.weight,\n            );\n        }\n\n        // Set final state\n        let final_weight = self.states[final_state].weight;\n        path.set_final(fst_states[path_states.len() - 1], final_weight);\n    }\n\n    pub fn reverse(&mut self) {\n        let mut new_states: Vec<StateData> = Vec::with_capacity(self.n_states);\n        for i in 0..self.n_states {\n            new_states.push(StateData {\n                arcs: Vec::new(),\n                final_state: self.states[i].final_state,\n                weight: self.states[i].weight,\n            });\n        }\n\n        // Reverse all arcs\n        for i in 0..self.n_states {\n            for arc in &self.states[i].arcs {\n                let next = arc.next_state.0;\n                new_states[next].arcs.push(ArcData {\n                    ilabel: arc.ilabel,\n                    olabel: arc.olabel,\n                    weight: arc.weight,\n                    next_state: State(i),\n                });\n            }\n        }\n\n        self.states = new_states;\n    }\n}\n\npub fn fst_trim(fst: &mut Fst) {\n    if fst.n_states == 0 {\n        return;\n    }\n\n    // Find reachable states from state 0\n    let mut reachable: Vec<bool> = vec![false; fst.n_states];\n    let mut stack: Vec<usize> = vec![0];\n    reachable[0] = true;\n\n    while let Some(state) = stack.pop() {\n        for arc in &fst.states[state].arcs {\n            let next = arc.next_state.0;\n            if !reachable[next] {\n                reachable[next] = true;\n                stack.push(next);\n            }\n        }\n    }\n\n    // Remove unreachable states\n    let mut new_states: Vec<StateData> = Vec::new();\n    let mut state_map: Vec<usize> = vec![0; fst.n_states]; // old index -> new index\n    let mut new_idx = 0;\n    for i in 0..fst.n_states {\n        if reachable[i] {\n            state_map[i] = new_idx;\n            new_states.push(fst.states[i].clone());\n            new_idx += 1;\n        } else {\n            state_map[i] = 0; // will be removed\n        }\n    }\n\n    // Update arcs to use new state indices\n    for state in &mut new_states {\n        state.arcs.retain(|arc| {\n            let next = arc.next_state.0;\n            if reachable[next] {\n                arc.next_state = State(state_map[next]);\n                true\n            } else {\n                false\n            }\n        });\n    }\n\n    fst.states = new_states;\n    fst.n_states = fst.states.len();\n}\n\n// ==================== BitSet ====================\n\n#[derive(Debug, Clone)]\npub struct BitSet {\n    bits: Vec<bool>,\n}\n\nimpl BitSet {\n    pub fn new(size: usize) -> Self {\n        BitSet {\n            bits: vec![false; size],\n        }\n    }\n\n    pub fn set(&mut self, index: usize) {\n        if index < self.bits.len() {\n            self.bits[index] = true;\n        }\n    }\n\n    pub fn get(&self, index: usize) -> bool {\n        if index < self.bits.len() {\n            self.bits[index]\n        } else {\n            false\n        }\n    }\n\n    pub fn set_all(&mut self) {\n        for bit in &mut self.bits {\n            *bit = true;\n        }\n    }\n\n    pub fn clear_all(&mut self) {\n        for bit in &mut self.bits {\n            *bit = false;\n        }\n    }\n}\n\n// ==================== HashTable ====================\n\n#[derive(Debug, Clone)]\npub struct HashTable<K, V> {\n    table: HashMap<K, V>,\n    capacity: usize,\n}\n\nimpl<K: Eq + Hash, V> HashTable<K, V> {\n    pub fn new(_hash_fn: fn(&K) -> usize, capacity: usize) -> Self {\n        HashTable {\n            table: HashMap::with_capacity(capacity),\n            capacity,\n        }\n    }\n\n    pub fn insert(&mut self, key: K, value: V) {\n        self.table.insert(key, value);\n    }\n\n    pub fn get(&self, key: &K) -> Option<&V> {\n        self.table.get(key)\n    }\n\n    pub fn remove(&mut self, key: &K) -> Option<V> {\n        self.table.remove(key)\n    }\n}\n\n// ==================== Heap ====================\n\n#[derive(Debug, Clone)]\npub struct Heap<T> {\n    items: Vec<T>,\n    cmp_fn: Box<dyn Fn(&T, &T) -> Ordering>,\n    max: usize,\n    limit: usize,\n}\n\nimpl<T> Heap<T> {\n    pub fn new(\n        cmp_fn: impl Fn(&T, &T) -> Ordering + 'static,\n        _size: usize,\n        max: usize,\n        limit: usize,\n    ) -> Self {\n        Heap {\n            items: Vec::new(),\n            cmp_fn: Box::new(cmp_fn),\n            max,\n            limit,\n        }\n    }\n\n    fn sift_up(&mut self, index: usize) {\n        let mut i = index;\n        while i > 0 {\n            let parent = (i - 1) / 2;\n            if (self.cmp_fn)(&self.items[i], &self.items[parent]) == Ordering::Less {\n                self.items.swap(i, parent);\n                i = parent;\n            } else {\n                break;\n            }\n        }\n    }\n\n    fn sift_down(&mut self, index: usize) {\n        let mut i = index;\n        let n = self.items.len();\n        loop {\n            let left = 2 * i + 1;\n            let right = 2 * i + 2;\n            let mut smallest = i;\n\n            if left < n && (self.cmp_fn)(&self.items[left], &self.items[smallest]) == Ordering::Less {\n                smallest = left;\n            }\n            if right < n && (self.cmp_fn)(&self.items[right], &self.items[smallest]) == Ordering::Less {\n                smallest = right;\n            }\n\n            if smallest != i {\n                self.items.swap(i, smallest);\n                i = smallest;\n            } else {\n                break;\n            }\n        }\n    }\n\n    pub fn insert(&mut self, item: T) {\n        if self.items.len() >= self.max {\n            return;\n        }\n        self.items.push(item);\n        self.sift_up(self.items.len() - 1);\n    }\n\n    pub fn pop(&mut self) -> Option<T> {\n        if self.items.is_empty() {\n            return None;\n        }\n        let min = self.items[0].clone();\n        let last = self.items.pop().unwrap();\n        if !self.items.is_empty() {\n            self.items[0] = last;\n            self.sift_down(0);\n        }\n        Some(min)\n    }\n\n    pub fn find(&self, item: &T) -> Option<usize> {\n        for (i, v) in self.items.iter().enumerate() {\n            if (self.cmp_fn)(v, item) == Ordering::Equal {\n                return Some(i);\n            }\n        }\n        None\n    }\n\n    pub fn update(&mut self, index: usize, new_item: T) {\n        if index < self.items.len() {\n            self.items[index] = new_item;\n            self.sift_up(index);\n            self.sift_down(index);\n        }\n    }\n}\n\n// ==================== Legacy C Translation: compatify array ====================\n\npub fn compatify_array() -> [i32; 10] {\n    let mut x: [i32; 10] = [1, 2, 0, 2, 0, 2, 0, 0, 5, 1];\n    let mut shift: i32 = 0;\n\n    for i in 0..10 {\n        if x[i] == 0 {\n            shift += 1;\n        } else {\n            if shift != 0 {\n                x[(i - shift as usize)] = x[i];\n            }\n        }\n    }\n\n    x\n}\n\npub fn compatify_array_print() -> String {\n    let x = compatify_array();\n    let mut result = String::new();\n    for i in 0..10 {\n        result.push_str(&format!(\"{} \", x[i]));\n    }\n    result.push('\\n');\n    result\n}\n\n// ==================== Assertion helpers ====================\n\npub fn assert_arc_equal(a: &ArcData, b: &ArcData) {\n    assert_eq!(a.ilabel, b.ilabel, \"ilabel mismatch\");\n    assert_eq!(a.olabel, b.olabel, \"olabel mismatch\");\n    assert!((a.weight - b.weight).abs() < 1e-9, \"weight mismatch\");\n    assert_eq!(a.next_state, b.next_state, \"next_state mismatch\");\n}\n\npub fn assert_state_equal(a: &StateData, b: &StateData) {\n    assert_eq!(a.final_state, b.final_state, \"final_state mismatch\");\n    assert!((a.weight - b.weight).abs() < 1e-9, \"weight mismatch\");\n    assert_eq!(a.arcs.len(), b.arcs.len(), \"arcs length mismatch\");\n    for i in 0..a.arcs.len() {\n        assert_arc_equal(&a.arcs[i], &b.arcs[i]);\n    }\n}\n\npub fn assert_fst_equal(a: &Fst, b: &Fst) {\n    assert_eq!(a.n_states, b.n_states, \"n_states mismatch\");\n    for i in 0..a.n_states {\n        assert_state_equal(&a.states[i], &b.states[i]);\n    }\n}"), best_reward: 0.0 }
