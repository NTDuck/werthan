abel {\n                    ll -= 1;\n                }\n                while hh < h && a[i].olabel == b[hh + 1].ilabel {\n                    hh += 1;\n                }\n\n                while ll <= hh {\n                    let mi = MatchItem {\n                        a: a[i],\n                        b: b[ll],\n                    };\n                    if _match(a, b, i, ll) {\n                        q.push_back(mi);\n                    }\n                    ll += 1;\n                }\n                found = true;\n                break;\n            }\n        }\n        let _ = found;\n    }\n}\n\npub fn match_half_sorted_rev(\n    a: &[ArcData],\n    b: &[ArcData],\n    m: usize,\n    n: usize,\n    q: &mut Queue<MatchItem>,\n) {\n    for i in 0..n {\n        let mut l = 0usize;\n        let mut h = if m > 0 { m - 1 } else { 0 };\n        let mut found = false;\n\n        while l <= h {\n            let mid = (l + h) / 2;\n            if b[i].ilabel > a[mid].olabel {\n                l = mid + 1;\n            } else if b[i].ilabel < a[mid].olabel {\n                if mid == 0 {\n                    break;\n                }\n                h = mid - 1;\n            } else {\n                let mut ll = mid;\n                let mut hh = mid;\n\n                while ll > l && b[i].ilabel == a[ll - 1].olabel {\n                    ll -= 1;\n                }\n                while hh < h && b[i].ilabel == a[hh + 1].olabel {\n                    hh += 1;\n                }\n\n                while ll <= hh {\n                    let mi = MatchItem {\n                        a: a[ll],\n                        b: b[i],\n                    };\n                    if _match(a, b, ll, i) {\n                        q.push_back(mi);\n                    }\n                    ll += 1;\n                }\n                found = true;\n                break;\n            }\n        }\n        let _ = found;\n    }\n}\n\npub fn match_full_sorted(\n    a: &