     state: dst,\n            ilabel,\n            olabel,\n            weight,\n        });\n    }\n\n    pub fn empty(&mut self) {\n        self.states.clear();\n        self.start = 0;\n    }\n\n    pub fn copy(&self) -> Fst {\n        Fst {\n            start: self.start,\n            states: self.states.clone(),\n        }\n    }\n}\n\n#[derive(Debug, Clone)]\npub struct BitSet {\n    pub bits: Vec<bool>,\n}\n\nimpl BitSet {\n    pub fn new(size: usize) -> Self {\n        BitSet {\n            bits: vec![false; size],\n        }\n    }\n\n    pub fn get(&self, idx: usize) -> bool {\n        if idx < self.bits.len() {\n            self.bits[idx]\n        } else {\n            false\n        }\n    }\n\n    pub fn set(&mut self, idx: usize, val: bool) {\n        if idx < self.bits.len() {\n            self.bits[idx] = val;\n        }\n    }\n\n    pub fn intersect(&mut self, other: &BitSet) {\n        for i in 0..self.bits.len().min(other.bits.len()) {\n            self.bits[i] = self.bits[i] && other.bits[i];\n        }\n    }\n\n    pub fn toggle_all(&mut self) {\n        for bit in self.bits.iter_mut() {\n            *bit = !*bit;\n        }\n    }\n}\n\npub struct FstIter {\n    pub marked: BitSet,\n    queue: VecDeque<usize>,\n    fst: Fst,\n}\n\nimpl FstIter {\n    pub fn new(fst: &Fst) -> Self {\n        let mut iter = FstIter {\n            marked: BitSet::new(fst.n_states()),\n            queue: VecDeque::new(),\n            fst: fst.copy(),\n        };\n        if fst.n_states() > 0 {\n            iter.marked.set(fst.start, true);\n            iter.queue.push_back(fst.start);\n        }\n        iter\n    }\n\n    pub fn next(&mut self) -> i32 {\n        if let Some(state) = self.queue.pop_front() {\n            for arc in &self.fst.states[state].arcs {\n                let dst = arc.state;\n                if !self.marked.get(dst) {\n                    self.marked.set(dst, true);\n                    self.queue.push_back(dst);\n                }\n    