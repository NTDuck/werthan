t);\n    }\n\n    pub fn compile_str(&mut self, input: &str) -> &mut Self {\n        let mut lines = input.lines();\n        for line in lines {\n            let line = line.trim();\n            if line.is_empty() {\n                continue;\n            }\n            if _parse_line(self, line) != 0 {\n                eprintln!(\"Invalid input line: {}\", line);\n                panic!(\"Parse error in compile_str\");\n            }\n        }\n        self\n    }\n\n    pub fn compile(\n        &mut self,\n        content: &str,\n        ist: Option<&SymTable>,\n        ost: Option<&SymTable>,\n        sst: Option<&SymTable>,\n        is_acc: bool,\n    ) -> &mut Self {\n        let mut lines = content.lines();\n        for line in lines {\n            let line = line.trim();\n            if line.is_empty() {\n                continue;\n            }\n            let res = if !is_acc {\n                _parse_line_sym(self, line, ist, ost, sst)\n            } else {\n                _parse_line_sym_acc(self, line, ist, sst)\n            };\n            if res != 0 {\n                eprintln!(\"Invalid input line: {}\", line);\n                panic!(\"Parse error in compile\");\n            }\n        }\n\n        if let Some(sst) = sst {\n            if let Some(start_state) = sst.getr(START_STATE) {\n                self.start = start_state;\n            }\n        }\n\n        self\n    }\n}\n\n#[derive(Debug, Clone)]\npub struct SymTable {\n    pub entries: Vec<(String, StateId)>,\n}\n\nimpl SymTable {\n    pub fn new() -> Self {\n        SymTable {\n            entries: Vec::new(),\n        }\n    }\n\n    pub fn insert(&mut self, token: &str, id: StateId) {\n        self.entries.push((token.to_string(), id));\n    }\n\n    pub fn getr(&self, token: &str) -> Option<StateId> {\n        for (t, id) in &self.entries {\n            if t == token {\n                return Some(*id);\n            }\n        }\n        None\n    }\n}\n\npub const START_STATE: &str = \"START\";\n\npub fn trn(token: &str) -> Option<StateId> {\n    token.parse::<StateId>().ok()\n}\n\npub fn trt(st: &SymTable, token: &str) -> Option<StateId> {\n    st.getr(token)\n}\n\npub fn _add_arc(fst: &mut Fst, sa: StateId, sb: StateId, li: Label, lo: Label, w: Weight) {\n    while sa + 1 > fst.n_states || sb + 1 > fst.n_states {\n        fst.add_state();\n    }\n    fst.add_arc(sa, sb, li, lo, w);\n}\n\npub fn _add_final(fst: &mut Fst, s: StateId, w: Weight) {\n    while s + 1 > fst.n_states {\n        fst.add_state();\n    }\n    fst.set_final(s, w);\n}\n\npub fn _parse_line(fst: &mut Fst, buf: &str) -> i32 {\n    let sr = sr_get(fst.sr_type);\n    let parts: Vec<&str> = buf.split_whitespace().collect();\n\n    if parts.len() == 5 {\n        let sa: StateId = parts[0].parse().unwrap();\n        let sb: StateId = parts[1].parse().unwrap();\n        let li: Label = parts[2].parse().unwrap();\n        let lo: Label = parts[3].parse().unwrap();\n        let w: Weight = parts[4].parse().unwrap();\n        _add_arc(fst, sa, sb, li, lo, w);\n        return 0;\n    } else if parts.len() == 4 {\n        let sa: StateId = parts[0].parse().unwrap();\n        let sb: StateId = parts[1].parse().unwrap();\n        let li: Label = parts[2].parse().unwrap();\n        let lo: Label = parts[3].parse().unwrap();\n        _add_arc(fst, sa, sb, li, lo, sr.one);\n        return 0;\n    } else if parts.len() == 2 {\n        let sf: StateId = parts[0].parse().unwrap();\n        let w: Weight = parts[1].parse().unwrap();\n        _add_final(fst, sf, w);\n        return 0;\n    } else if parts.len() == 1 {\n        let sf: StateId = parts[0].parse().unwrap();\n        _add_final(fst, sf, sr.one);\n        return 0;\n    }\n    -1\n}\n\npub fn _parse_line_sym(\n    fst: &mut Fst,\n    buf: &str,\n    ist: Option<&SymTable>,\n    ost: Option<&SymTable>,\n    sst: Option<&SymTable>,\n) -> i32 {\n    let sr = sr_get(fst.sr_type);\n    let parts: Vec<&str> = buf.split_whitespace().collect();\n\n    let itrans = |token: &str| -> Option<StateId> {\n        match ist {\n            Some(t) => trt(t, token),\n            None => trn(token),\n        }\n    };\n    let otrans = |token: &str| -> Option<StateId> {\n        match ost {\n            Some(t) => trt(t, token),\n            None => trn(token),\n        }\n    };\n    let strans = |token: &str| -> Option<StateId> {\n        match sst {\n            Some(t) => trt(t, token),\n            None => trn(token),\n        }\n    };\n\n    if parts.len() == 5 {\n        let sa = strans(parts[0]);\n        let sb = strans(parts[1]);\n        let li = itrans(parts[2]);\n        let lo = otrans(parts[3]);\n        let w: Weight = parts[4].parse().unwrap();\n\n        if sa.is_none() || sb.is_none() || li.is_none() || lo.is_none() {\n            return -1;\n        }\n        _add_arc(fst, sa.unwrap(), sb.unwrap(), li.unwrap() as Label, lo.unwrap() as Label, w);\n        return 0;\n    } else if parts.len() == 4 {\n        let sa = strans(parts[0]);\n        let sb = strans(parts[1]);\n        let li = itrans(parts[2]);\n        let lo = otrans(parts[3]);\n\n        if sa.is_none() || sb.is_none() || li.is_none() || lo.is_none() {\n            return -1;\n        }\n        _add_arc(fst, sa.unwrap(), sb.unwrap(), li.unwrap() as Label, lo.unwrap() as Label, sr.one);\n        return 0;\n    } else if parts.len() == 2 {\n        let sf = strans(parts[0]);\n        let w: Weight = parts[1].parse().unwrap();\n\n        if sf.is_none() {\n            return -1;\n        }\n        _add_final(fst, sf.unwrap(), w);\n        return 0;\n    } else if parts.len() == 1 {\n        let sf = strans(parts[0]);\n\n        if sf.is_none() {\n            return -1;\n        }\n        _add_final(fst, sf.unwrap(), sr.one);\n        return 0;\n    }\n    -1\n}\n\npub fn _parse_line_sym_acc(\n    fst: &mut Fst,\n    buf: &str,\n    ist: Option<&SymTable>,\n    sst: Option<&SymTable>,\n) -> i32 {\n    let sr = sr_get(fst.sr_type);\n    let parts: Vec<&str> = buf.split_whitespace().collect();\n\n    let itrans = |token: &str| -> Option<StateId> {\n        match ist {\n            Some(t) => trt(t, token),\n            None => trn(token),\n        }\n    };\n    let strans = |token: &str| -> Option<StateId> {\n        match sst {\n            Some(t) => trt(t, token),\n            None => trn(token),\n        }\n    };\n\n    if parts.len() == 4 {\n        let sa = strans(parts[0]);\n        let sb = strans(parts[1]);\n        let li = itrans(parts[2]);\n        let w: Weight = parts[3].parse().unwrap();\n\n        if sa.is_none() || sb.is_none() || li.is_none() {\n            return -1;\n        }\n        _add_arc(fst, sa.unwrap(), sb.unwrap(), li.unwrap() as Label, li.unwrap() as Label, w);\n        return 0;\n    } else if parts.len() == 3 {\n        let sa = strans(parts[0]);\n        let sb = strans(parts[1]);\n        let li = itrans(parts[2]);\n\n        if sa.is_none() || sb.is_none() || li.is_none() {\n            return -1;\n        }\n        _add_arc(fst, sa.unwrap(), sb.unwrap(), li.unwrap() as Label, li.unwrap() as Label, sr.one);\n        return 0;\n    } else if parts.len() == 2 {\n        let sf = strans(parts[0]);\n        let w: Weight = parts[1].parse().unwrap();\n\n        if sf.is_none() {\n            return -1;\n        }\n        _add_final(fst, sf.unwrap(), w);\n        return 0;\n    } else if parts.len() == 1 {\n        let sf = strans(parts[0]);\n\n        if sf.is_none() {\n            return -1;\n        }\n        _add_final(fst, sf.unwrap(), sr.one);\n        return 0;\n    }\n    -1\n}\n\npub fn assert_arc_equal(a: &Arc, b: &Arc) -> bool {\n    a.ilabel == b.ilabel && a.olabel == b.olabel && a.weight == b.weight && a.dest == b.dest\n}\n\npub fn assert_state_equal(a: &Fst, b: &Fst) -> bool {\n    a.n_states == b.n_states && a.start == b.start\n}\n\npub fn assert_fst_equal(a: &Fst, b: &Fst) -> bool {\n    if !assert_state_equal(a, b) {\n        return false;\n    }\n    if a.arcs.len() != b.arcs.len() {\n        return false;\n    }\n    for i in 0..a.arcs.len() {\n        if a.arcs[i].len() != b.arcs[i].len() {\n            return false;\n        }\n        for j in 0..a.arcs[i].len() {\n            if !assert_arc_equal(&a.arcs[i][j], &b.arcs[i][j]) {\n                return false;\n            }\n        }\n    }\n    for i in 0..a.finals.len() {\n        if a.finals[i] != b.finals[i] {\n            return false;\n        }\n    }\n    true\n}"), best_reward: 0.0 }
