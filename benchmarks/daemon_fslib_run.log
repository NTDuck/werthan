= 1`, the state index\n/// is enqueued into a temporary queue. Finally, for each state in the queue,\n/// it prints `{state}\\t{state.weight:.6f}`.\npub fn fst_print(fst: &Fst) {\n    let mut finals: Vec<u32> = Vec::new();\n\n    for s in 0..fst.n_states {\n        let state = &fst.states[s];\n        for a in 0..state.n_arcs {\n            let arc = &state.arcs[a];\n            print!(\n                \"{}\\t{}\\t{}\\t{}\\t{:.5}\\n\",\n                s, arc.state, arc.ilabel, arc.olabel, arc.weight\n            );\n        }\n\n        if state.final == 1 {\n            finals.push(s);\n        }\n    }\n\n    for &s in &finals {\n        let state = &fst.states[s];\n        print!(\"{}\\t{:.6}\\n\", s, state.weight);\n    }\n}\n\n/// Translation function for numeric fallback.\n/// Formats the ID as a string using `%zu` equivalent.\npub fn trn(_st: Option<&SymTable>, id: u64, token: &mut String) -> Option<&str> {\n    token.clear();\n    let _ = write!(token, \"{}\", id);\n    Some(token.as_str())\n}\n\n/// Translation function for symbolic lookup.\n/// Looks up the string token via `symt_get`.\npub fn trt(st: Option<&SymTable>, id: u64, token: &mut String) -> Option<&str> {\n    match st {\n        Some(table) => {\n            match table.get(id) {\n                Some(t) => {\n                    token.clear();\n                    token.push_str(t);\n                    Some(token.as_str())\n                }\n                None => {\n                    eprintln!(\"Unknown token: \");\n                    None\n                }\n            }\n        }\n        None => {\n            token.clear();\n            let _ = write!(token, \"{}\", id);\n            Some(token.as_str())\n        }\n    }\n}\n\n/// Prints the FST in symbolic format.\n///\n/// Uses `SymTable` pointers for input (`ist`), output (`ost`), and state (`sst`) symbols.\n/// If a symbol table is `None`, it uses the numeric translation function.\n/// If a symbol table is provided, it uses `trt` to look up the string token.\n///\n/// If any translation returns `None`, prints \"Invalid symbol\\n\" to stderr and exits.\npub fn fst_print_sym(\n    fst: &Fst,\n    ist: Option<&SymTable>,\n    ost: Option<&SymTable>,\n    sst: Option<&SymTable>,\n) {\n    let mut finals: Vec<u32> = Vec::new();\n    let mut sa = String::new();\n    let mut sb = String::new();\n    let mut li = String::new();\n    let mut lo = String::new();\n\n    for s in 0..fst.n_states {\n        let state = &fst.states[s];\n        for a in 0..state.n_arcs {\n            let arc = &state.arcs[a];\n\n            let sa_res = trt(sst, s as u64, &mut sa);\n            let sb_res = trt(sst, arc.state as u64, &mut sb);\n            let li_res = trt(ist, arc.ilabel as u64, &mut li);\n            let lo_res = trt(ost, arc.olabel as u64, &mut lo);\n\n            if sa_res.is_none() || sb_res.is_none() || li_res.is_none() || lo_res.is_none() {\n                eprintln!(\"Invalid symbol\");\n                exit(1);\n            }\n\n            print!(\n                \"{}\\t{}\\t{}\\t{}\\t{:.5}\\n\",\n                sa, sb, li, lo, arc.weight\n            );\n        }\n\n        if state.final == 1 {\n            finals.push(s);\n        }\n    }\n\n    for &s in &finals {\n        let state = &fst.states[s];\n\n        let sa_res = trt(sst, s as u64, &mut sa);\n        if sa_res.is_none() {\n            eprintln!(\"Invalid symbol\");\n            exit(1);\n        }\n\n        print!(\"{}\\t{:.6}\\n\", sa, state.weight);\n    }\n}"), best_reward: 0.0 }
