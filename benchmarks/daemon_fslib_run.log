" ];\",\n                s, arc.state, arc.ilabel, arc.olabel, arc.weight\n            )\n            .unwrap();\n        }\n    }\n\n    write!(writer, \"{}\", FOOTER).unwrap();\n    0\n}\n\npub fn trn(_st: &SymTable, id: usize, token: &mut String) -> Option<String> {\n    token.clear();\n    token.push_str(&id.to_string());\n    Some(token.clone())\n}\n\npub fn trt(st: &SymTable, id: usize, token: &mut String) -> Option<String> {\n    match st.get(id) {\n        Some(s) => {\n            token.clear();\n            token.push_str(s);\n            Some(token.clone())\n        }\n        None => {\n            eprintln!(\"Unknown token: {}\", \"\");\n            None\n        }\n    }\n}\n\npub fn fst_draw_sym(\n    fst: &Fst,\n    fout: &mut File,\n    ist: &Option<SymTable>,\n    ost: &Option<SymTable>,\n    sst: &Option<SymTable>,\n) -> i32 {\n    let mut writer = fout;\n    write!(writer, \"{}\", HEADER).unwrap();\n\n    for s in 0..fst.n_states {\n        let state = &fst.states[s as usize];\n\n        let mut sa = String::new();\n        let sa_result = match sst {\n            Some(table) => trt(table, s as usize, &mut sa),\n            None => trn(&SymTable::new(), s as usize, &mut sa),\n        };\n\n        let sa_str = match sa_result {\n            Some(val) => val,\n            None => {\n                eprintln!(\"Invalid symbol\");\n                std::process::exit(1);\n            }\n        };\n\n        if !state.final {\n            let style = if s == fst.start { \"filled\" } else { \"solid\" };\n            writeln!(\n                writer,\n                \"\\t{} [label = \\\"{}\\\", shape = circle, style = {} ];\",\n                sa_str, sa_str, style\n            )\n            .unwrap();\n        } else {\n            writeln!(\n                writer,\n                \"\\t{} [label = \\\"{}\\\", shape = doublecircle, style = filled ];\",\n                sa_str, sa_str\n            )\n            .unwrap();\n        }\n\n        for arc in &state.arcs {\n            let mut sb = String::new();\n            let mut li = String::new();\n            let mut lo = String::new();\n\n            let sb_result = match sst {\n                Some(table) => trt(table, arc.state as usize, &mut sb),\n                None => trn(&SymTable::new(), arc.state as usize, &mut sb),\n            };\n\n            let li_result = match ist {\n                Some(table) => trt(table, arc.ilabel as usize, &mut li),\n                None => trn(&SymTable::new(), arc.ilabel as usize, &mut li),\n            };\n\n            let lo_result = match ost {\n                Some(table) => trt(table, arc.olabel as usize, &mut lo),\n                None => trn(&SymTable::new(), arc.olabel as usize, &mut lo),\n            };\n\n            let (sb_str, li_str, lo_str) = match (sb_result, li_result, lo_result) {\n                (Some(a), Some(b), Some(c)) => (a, b, c),\n                _ => {\n                    eprintln!(\"Invalid symbol\");\n                    std::process::exit(1);\n                }\n            };\n\n            writeln!(\n                writer,\n                \"\\t\\t{} -> {} [ label = \\\"{}:{}/{}\\\" ];\",\n                sa_str, sb_str, li_str, lo_str, arc.weight\n            )\n            .unwrap();\n        }\n    }\n\n    write!(writer, \"{}\", FOOTER).unwrap();\n    0\n}\n\npub fn assert_arc_equal(a: &Arc, b: &Arc) {\n    assert_eq!(a.state, b.state);\n    assert_eq!(a.ilabel, b.ilabel);\n    assert_eq!(a.olabel, b.olabel);\n    assert!((a.weight - b.weight).abs() < f64::EPSILON);\n}\n\npub fn assert_state_equal(a: &State, b: &State) {\n    assert_eq!(a.final, b.final);\n    assert_eq!(a.arcs.len(), b.arcs.len());\n    for i in 0..a.arcs.len() {\n        assert_arc_equal(&a.arcs[i], &b.arcs[i]);\n    }\n}\n\npub fn assert_fst_equal(a: &Fst, b: &Fst) {\n    assert_eq!(a.n_states, b.n_states);\n    assert_eq!(a.start, b.start);\n    assert_eq!(a.states.len(), b.states.len());\n    for i in 0