_arcs;\n    }\n}\n\npub fn fst_get_finals(fst: &Fst, finals: &mut VecDeque<usize>) {\n    for s in 0..fst.n_states() {\n        if fst.states[s].final {\n            finals.push_back(s);\n        }\n    }\n}\n\npub fn fst_trim(fst: &mut Fst) {\n    let mut finals = VecDeque::new();\n    fst_get_finals(fst, &mut finals);\n\n    if finals.len() == 0 {\n        fst.empty();\n    } else {\n        if finals.len() > 1 {\n            fst_close(fst, &mut finals);\n        }\n\n        let mut iter = FstIter::new(fst);\n        while iter.next() != -1 {}\n\n        fst_reverse(fst);\n\n        let mut iter_rev = FstIter::new(fst);\n        while iter_rev.next() != -1 {}\n\n        fst_reverse(fst);\n\n        iter.marked.intersect(&iter_rev.marked);\n        iter.marked.toggle_all();\n\n        fst_rm_states(fst, &iter.marked);\n    }\n}"), best_reward: 0.0 }
